! ---------------------------------------------------------------------------
!  Synode NX GLB Exporter - MenuScript
!
!  Loaded by NX from %UGII_USER_DIR%\startup at start-up.  Adds the top level
!  menu "Synode" (in the NX "Menu" drop-down) with the command "Export to GLB".
!  The ACTIONS file is resolved by NX in %UGII_USER_DIR%\application.
!
!  NOTE: syntax follows the NX 2606 menu files in UGII\menus (VERSION 120,
!  EDIT UG_GATEWAY_MAIN_MENUBAR, BEFORE ... END_OF_BEFORE, MENU ... END_OF_MENU).
!  A Python journal as ACTIONS target must be confirmed in your NX session
!  (see README, section "Tich hop menu/ribbon").
! ---------------------------------------------------------------------------

VERSION 120

EDIT UG_GATEWAY_MAIN_MENUBAR

BEFORE UG_HELP
  CASCADE_BUTTON SYNODE_MAIN_MENU
  LABEL &Synode
END_OF_BEFORE

MENU SYNODE_MAIN_MENU
  BUTTON SYNODE_EXPORT_GLB
  LABEL Export to GLB
  TOOLBAR_LABEL Export to GLB
  MESSAGE Exports the displayed part or assembly (hierarchy, transforms, colours) to a binary glTF (.glb) file.
  SYNONYMS glb, gltf, export glb, synode
  BITMAP filesave
  ACTIONS synode_export_glb.py
END_OF_MENU
