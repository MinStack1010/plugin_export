<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Synode Exporter - COM add-in for Siemens Solid Edge 2026.
    * .NET Framework 4.8, x64 (Edge.exe is a 64-bit process, CLR v4).
    * References the OFFICIAL interop assemblies installed by Solid Edge in its
      Program folder (neither embedded nor copied: Edge.exe loads them from its
      own folder).
    * No NuGet/third-party dependencies (the GLB writer is pure C#).
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>SynodeExporter.SolidEdge</AssemblyName>
    <RootNamespace>SynodeExporter</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <DebugType>pdbonly</DebugType>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SolidEdgeProgramDir Condition="'$(SolidEdgeProgramDir)' == ''">C:\Program Files\Siemens\Solid Edge 2026\Program</SolidEdgeProgramDir>
  </PropertyGroup>

  <!-- Ribbon icons (RT_BITMAP 101/102) generated by scripts\New-IconResource.ps1 -->
  <PropertyGroup Condition="'$(Win32ResourceFile)' != '' and Exists('$(Win32ResourceFile)')">
    <Win32Resource>$(Win32ResourceFile)</Win32Resource>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Interop.SolidEdgeFrameworkLib">
      <HintPath>$(SolidEdgeProgramDir)\interop.SolidEdgeFrameworkLib.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="Interop.SolidEdgePartLib">
      <HintPath>$(SolidEdgeProgramDir)\interop.SolidEdgePartLib.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="Interop.SolidEdgeAssemblyLib">
      <HintPath>$(SolidEdgeProgramDir)\interop.SolidEdgeAssemblyLib.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="Interop.SolidEdgeGeometryLib">
      <HintPath>$(SolidEdgeProgramDir)\interop.SolidEdgeGeometryLib.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="Interop.SolidEdgeConstantLib">
      <HintPath>$(SolidEdgeProgramDir)\interop.SolidEdgeConstantLib.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
