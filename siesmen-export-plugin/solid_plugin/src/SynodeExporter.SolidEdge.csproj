<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Synode Exporter - COM add-in cho Siemens Solid Edge 2026.
    * .NET Framework 4.8, x64 (Edge.exe là tiến trình 64-bit, CLR v4).
    * Tham chiếu các interop assembly CHÍNH THỨC do Solid Edge cài đặt trong
      thư mục Program (không nhúng, không copy: Edge.exe nạp chúng từ chính
      thư mục của nó).
    * Không phụ thuộc NuGet/thư viện ngoài (GLB writer viết thuần C#).
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>SynodeExporter.SolidEdge</AssemblyName>
    <RootNamespace>SynodeExporter</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <DebugType>pdbonly</DebugType>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SolidEdgeProgramDir Condition="'$(SolidEdgeProgramDir)' == ''">C:\Program Files\Siemens\Solid Edge 2026\Program</SolidEdgeProgramDir>
  </PropertyGroup>

  <!-- Icon ribbon (RT_BITMAP 101/102) sinh bởi scripts\New-IconResource.ps1 -->
  <PropertyGroup Condition="'$(Win32ResourceFile)' != '' and Exists('$(Win32ResourceFile)')">
    <Win32Resource>$(Win32ResourceFile)</Win32Resource>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Interop.SolidEdgeFrameworkLib">
      <HintPath>$(SolidEdgeProgramDir)\interop.SolidEdgeFrameworkLib.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="Interop.SolidEdgePartLib">
      <HintPath>$(SolidEdgeProgramDir)\interop.SolidEdgePartLib.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="Interop.SolidEdgeAssemblyLib">
      <HintPath>$(SolidEdgeProgramDir)\interop.SolidEdgeAssemblyLib.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="Interop.SolidEdgeGeometryLib">
      <HintPath>$(SolidEdgeProgramDir)\interop.SolidEdgeGeometryLib.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <Reference Include="Interop.SolidEdgeConstantLib">
      <HintPath>$(SolidEdgeProgramDir)\interop.SolidEdgeConstantLib.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
