<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Bộ test của Synode Exporter cho Solid Edge (console, không cần NuGet).
    * net48  : unit test phần Core đúng runtime mà Edge.exe dùng (CLR 4.8, x64)
               và xuất các GLB mẫu để so sánh chéo.
    * net9.0 : unit test + đối chiếu với writer GỐC của plugin SOLIDWORKS
               (Export\*.cs được liên kết chỉ-đọc, không copy/sửa) + SharpGLTF 1.0.6
               từ thư mục packages của plugin SW.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net9.0</TargetFrameworks>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SynodeExporter.Tests</RootNamespace>
    <AssemblyName>SynodeExporter.Tests</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SolidPluginSrc Condition="'$(SolidPluginSrc)' == ''">$(MSBuildThisFileDirectory)..\..\src\</SolidPluginSrc>
    <SwPluginDir Condition="'$(SwPluginDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\solidworks-export-plugin\</SwPluginDir>
    <SharpGltfLib Condition="'$(SharpGltfLib)' == ''">net8.0</SharpGltfLib>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(SolidPluginSrc)Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <DefineConstants>$(DefineConstants);REFERENCE_SW</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <Compile Include="$(SwPluginDir)Export\ExtractedScene.cs" Link="SwSources\ExtractedScene.cs" />
    <Compile Include="$(SwPluginDir)Export\ExtractedNode.cs" Link="SwSources\ExtractedNode.cs" />
    <Compile Include="$(SwPluginDir)Export\ExtractedMesh.cs" Link="SwSources\ExtractedMesh.cs" />
    <Compile Include="$(SwPluginDir)Export\ExtractedMaterial.cs" Link="SwSources\ExtractedMaterial.cs" />
    <Compile Include="$(SwPluginDir)Export\ExportOptions.cs" Link="SwSources\ExportOptions.cs" />
    <Compile Include="$(SwPluginDir)Export\CoordinateConverter.cs" Link="SwSources\CoordinateConverter.cs" />
    <Compile Include="$(SwPluginDir)Export\GltfSceneWriter.cs" Link="SwSources\GltfSceneWriter.cs" />
    <Reference Include="SharpGLTF.Core">
      <HintPath>$(SwPluginDir)packages\SharpGLTF.Core.1.0.6\lib\$(SharpGltfLib)\SharpGLTF.Core.dll</HintPath>
    </Reference>
    <Reference Include="SharpGLTF.Runtime">
      <HintPath>$(SwPluginDir)packages\SharpGLTF.Runtime.1.0.6\lib\$(SharpGltfLib)\SharpGLTF.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="SharpGLTF.Toolkit">
      <HintPath>$(SwPluginDir)packages\SharpGLTF.Toolkit.1.0.6\lib\$(SharpGltfLib)\SharpGLTF.Toolkit.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
