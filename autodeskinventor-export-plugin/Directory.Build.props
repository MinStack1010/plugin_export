<Project>

  <!--
    Common settings for all projects.

    Target framework:
      Inventor 2027 hosts managed add-ins on .NET 10 (Bin\ClrAddinLoader.runtimeconfig.json: "tfm": "net10.0").
      * .NET SDK 10.x installed -> build net10.0-windows (matches the Inventor 2027 runtime).
      * Only SDK 8/9 installed  -> build net8.0-windows. A net8.0 assembly loads normally on the .NET 10 runtime
                                   (forward compatible). build.ps1 picks the framework and prints a warning.
      To force a framework: dotnet build -p:SynodeTargetFramework=net10.0-windows
  -->
  <PropertyGroup>
    <!-- NETCoreSdkVersion is not available at this point; MSBuild 18.x ships with .NET SDK 10. build.ps1 always passes an explicit value. -->
    <SynodeTargetFramework Condition="'$(SynodeTargetFramework)' == '' and $([MSBuild]::VersionGreaterThanOrEquals('$(MSBuildVersion)', '18.0'))">net10.0-windows</SynodeTargetFramework>
    <SynodeTargetFramework Condition="'$(SynodeTargetFramework)' == ''">net8.0-windows</SynodeTargetFramework>

    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>1.0.0</Version>
    <Company>Synode</Company>
    <Product>Synode Inventor Exporter</Product>
    <Copyright>Synode</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Inventor 2027 installation folder (used only at build time to reference the interop assembly). build.ps1 passes the value read from the registry. -->
    <InventorBinDir Condition="'$(InventorBinDir)' == ''">$(ProgramFiles)\Autodesk\Inventor 2027\Bin</InventorBinDir>
  </PropertyGroup>

</Project>
