<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Synode Inventor Exporter - core library with NO dependency on the Inventor API:
    GLB validation, export path handling, logging, error codes.
    The sources of this project are also compiled (linked) directly into the add-in so that
    the add-in is a SINGLE DLL (avoids dependency resolution risks inside Inventor).
  -->

  <PropertyGroup>
    <TargetFramework>$(SynodeTargetFramework)</TargetFramework>
    <AssemblyName>SynodeInventor.Core</AssemblyName>
    <RootNamespace>Synode.Inventor.Core</RootNamespace>
  </PropertyGroup>

</Project>
