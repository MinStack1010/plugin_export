<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Synode Inventor Exporter - phần lõi KHÔNG phụ thuộc Inventor API:
    kiểm tra GLB, xử lý đường dẫn xuất, logging, mã lỗi.
    Mã nguồn của project này cũng được biên dịch (liên kết) thẳng vào add-in để
    add-in chỉ là MỘT DLL (tránh rủi ro phân giải dependency trong Inventor).
  -->

  <PropertyGroup>
    <TargetFramework>$(SynodeTargetFramework)</TargetFramework>
    <AssemblyName>SynodeInventor.Core</AssemblyName>
    <RootNamespace>Synode.Inventor.Core</RootNamespace>
  </PropertyGroup>

</Project>
