<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Synode Inventor Exporter - add-in for Autodesk Inventor Professional 2027.
    Inventor loads the add-in through the .addin manifest file (NO RegAsm / COM registration in the registry).
    Output: a SINGLE DLL, SynodeInventor.AddIn.dll (the Core sources are compiled into it).
    No NuGet packages, no dependency on WinForms/WPF.
  -->

  <PropertyGroup>
    <TargetFramework>$(SynodeTargetFramework)</TargetFramework>
    <AssemblyName>SynodeInventor.AddIn</AssemblyName>
    <RootNamespace>Synode.Inventor.AddIn</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SynodeInventor.Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Interop assemblies installed with Inventor 2027; Inventor provides them at runtime, so Private=false (not copied). -->
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorBinDir)\Public Assemblies\Autodesk.Inventor.Interop.dll</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="stdole">
      <HintPath>$(InventorBinDir)\stdole.dll</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Synode.InventorExporter.addin.template" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
