<?xml version="1.0" encoding="utf-8"?>
<!--
  Add-in manifest for Synode Inventor Exporter, Autodesk Inventor 2027 (RegistryVersion 31.x).
  install.ps1 copies this file into the same folder as SynodeInventor.AddIn.dll, for example:
    %APPDATA%\Autodesk\Inventor 2027\Addins\SynodeInventorExporter\
  <Assembly> is a path relative to the location of the .addin file (same as the Autodesk Assistant add-in).
  ClassId/ClientId must match the [Guid] of the StandardAddInServer class.
-->
<Addin Type="Standard">
  <ClassId>{7001FEF0-B792-4C1D-9FB4-0515C8F2F90B}</ClassId>
  <ClientId>{7001FEF0-B792-4C1D-9FB4-0515C8F2F90B}</ClientId>
  <DisplayName>Synode Inventor Exporter</DisplayName>
  <Description>Synode: export the active Inventor part (.ipt) or assembly (.iam) to glTF 2.0 binary (.glb).</Description>
  <Assembly>SynodeInventor.AddIn.dll</Assembly>
  <SupportedSoftwareVersionGreaterThan>30..</SupportedSoftwareVersionGreaterThan>
  <LoadOnStartUp>1</LoadOnStartUp>
  <UserUnloadable>1</UserUnloadable>
  <Hidden>0</Hidden>
  <DataVersion>1</DataVersion>
  <UserInterfaceVersion>1</UserInterfaceVersion>
</Addin>
