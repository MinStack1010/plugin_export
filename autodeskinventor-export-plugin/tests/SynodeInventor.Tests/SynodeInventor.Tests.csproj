<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit test runner (console, KHÔNG cần NuGet/xUnit để build được offline).
    Kiểm thử phần lõi không phụ thuộc Inventor: GlbValidator, ExportPathHelper, IconRenderer, FileLogger.
    Chạy: build.ps1 (tự chạy) hoặc tests\run_tests.ps1
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(SynodeTargetFramework)</TargetFramework>
    <AssemblyName>SynodeInventor.Tests</AssemblyName>
    <RootNamespace>Synode.Inventor.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SynodeInventor.Core\SynodeInventor.Core.csproj" />
  </ItemGroup>

</Project>
